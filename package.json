{
  "name": "anatomical-symptom-interface",
  "version": "0.1.0",
  "private": true,
  "description": "Anatomical Symptom Interface — turn \"it hurts here\" into a structured, anatomical, longitudinal health record",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@asi/web\" --filter \"@asi/server\" dev",
    "dev:web": "pnpm --filter @asi/web dev",
    "dev:server": "pnpm --filter @asi/server dev",
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm --filter @asi/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "seed": "pnpm --filter @asi/server seed",
    "preview": "bash preview/preview.sh restart",
    "preview:stop": "bash preview/preview.sh stop",
    "preview:status": "bash preview/preview.sh status",
    "preview:verify": "node preview/verify-preview.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
