# Normalize line endings so the repo behaves identically on Windows, WSL and CI.
* text=auto eol=lf

*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.svg  text eol=lf

*.png  binary
*.jpg  binary
*.glb  binary
*.zip  binary
*.sqlite binary
