*.tsbuildinfo

# local health data — NEVER commit
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
.env
.env.*
!.env.example

# anatomy model assets are large, fetched by script
packages/server/assets/anatomy/*.glb
packages/server/assets/anatomy/*.zip
packages/server/assets/anatomy/*.mtl

# BodyParts3D SOURCE assets: large, third-party, CC BY 4.0, and never ours to
# redistribute. The extracted archive goes in assets/anatomy/source/ and stays out
# of the repo. The GENERATED output in assets/anatomy/generated/ is small,
# reproducible and reviewable, so it IS committed once it exists.
assets/anatomy/source/
*.obj
*.zip

.DS_Store
Thumbs.db
.vscode/
.idea/

# Blender spike artefacts: DERIVED and regenerable, so not committed.
# shoulder.blend is 24.5 MB and the 20 gate renders are 16.5 MB. The scripts that
# produce them, the verdict, and the data they were built from ARE committed, and
# spikes/shoulder-geometry/GEOMETRY-GATE.md documents the exact commands to
# rebuild. Committing 41 MB of derived binaries on a feature branch is not worth
# it, and it would make every future diff of the spike expensive.
spikes/**/*.blend
spikes/**/*.blend1
spikes/**/renders/*.png

# preview runtime state (synthetic demo database)
preview/.preview-data/
